rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // وثيقة الموردين المشتركة: فقط المستخدم المسجّل دخوله يقرأ ويكتب.
    // The shared vendors document: only signed-in users can read/write.
    match /app/vendors {
      allow read, write: if request.auth != null;
    }

    // امنع أي وصول لأي مسار آخر افتراضياً.
    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
